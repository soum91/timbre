#!/bin/sh
# A rootless app is installed under /var/jb/Applications.
# Register it explicitly with LaunchServices/SpringBoard after dpkg unpacks it.
if [ "${1:-configure}" = configure ]; then
    UICACHE=/var/jb/usr/bin/uicache
    [ -x "$UICACHE" ] || UICACHE=/usr/bin/uicache
    if [ -x "$UICACHE" ]; then
        "$UICACHE" -p /var/jb/Applications/TimbreControl.app || true
    fi
    # Root helper used by the app to restart the audio daemon and repair permissions.
    HELPER=/var/jb/usr/libexec/timbrectl
    if [ -e "$HELPER" ]; then chown root:wheel "$HELPER" && chmod 4755 "$HELPER"; fi
    # Settings live under the jailbreak root so sandboxed mediaserverd can read them.
    PREFS=/var/jb/var/mobile/Library/Preferences
    mkdir -p "$PREFS" 2>/dev/null || true
    chown mobile:mobile /var/jb/var/mobile /var/jb/var/mobile/Library "$PREFS" 2>/dev/null || true
    if [ ! -e "$PREFS/com.soum91.timbreaudio.plist" ] && [ -e /var/mobile/Library/Preferences/com.soum91.timbreaudio.plist ]; then
        cp /var/mobile/Library/Preferences/com.soum91.timbreaudio.plist "$PREFS/" 2>/dev/null || true
    fi
    chown mobile:mobile "$PREFS/com.soum91.timbreaudio.plist" 2>/dev/null || true
    # Cast daemon: (re)load under launchd so a new binary takes effect.
    DAEMON=/var/jb/Library/LaunchDaemons/com.soum91.timbrecastd.plist
    LAUNCHCTL=/var/jb/usr/bin/launchctl
    [ -x "$LAUNCHCTL" ] || LAUNCHCTL=launchctl
    if [ -e "$DAEMON" ]; then
        chown root:wheel "$DAEMON" 2>/dev/null; chmod 644 "$DAEMON" 2>/dev/null
        "$LAUNCHCTL" unload "$DAEMON" >/dev/null 2>&1 || true
        "$LAUNCHCTL" load -w "$DAEMON" >/dev/null 2>&1 || true
    fi
    # Respringing does not restart the audio daemon; restart it so the new tweak loads now.
    "$HELPER" restart-audio >/dev/null 2>&1 || for p in mediaserverd audiomxd; do
        killall -9 "$p" 2>/dev/null || pkill -9 -x "$p" 2>/dev/null || true
    done
fi
exit 0
